# FastAPI address reachable FROM THE NEXT.JS SERVER (not from the phone).
# For separate hosting, replace this with the actual backend address.
# Set before building: WebSocket rewrites use this value at build time.
FASTAPI_HTTP_BASE_URL=http://127.0.0.1:8000

# HTTP and WebSocket requests use the website's origin by default.
# Only if your hosting cannot proxy WebSocket upgrades, use a public WSS URL:
# NEXT_PUBLIC_FASTAPI_WS_BASE_URL=wss://api.example.com
